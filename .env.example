# Copy to .env.local and edit. Every value here is optional.

# Absolute path to your Obsidian vault. You can also set this in the
# Settings page instead, which stores it in the database — this env var
# wins if both are set.
# OBSIDIAN_VAULT=/Users/you/Documents/MyVault

# Port for the production server (scripts/serve.sh). Default 3000.
# PORT=3000

# NTU COOL sync (「同步 NTU COOL」). Preferred (macOS): no setting here - store your
# NTU account in the keychain and the server logs in by itself, again whenever
# COOL refuses the old login (see the README):
#   security add-generic-password -s alex-system-ntu -a <student ID> -w
# NTU_KEYCHAIN_SERVICE=alex-system-ntu
#
# Fallback: the browser's session cookie, which stops working when the login
# session expires. Open DevTools → Network, click any request to
# cool.ntu.edu.tw and copy the whole `Cookie` request header value.
# The keychain wins when both are set.
# COOL_COOKIE=_legacy_normandy_session=...; _normandy_session=...;log_session_id=...

# With either one, the server also syncs COOL on its own: between 08:00 and
# 18:00, whenever the last sync is over an hour old, with a macOS notification
# for new assignments and announcements. Set to 0 to turn that off.
# COOL_AUTO_SYNC=0
