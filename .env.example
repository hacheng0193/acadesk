# Copy to .env.local and edit. Every value here is optional.

# Absolute path to your Obsidian vault. You can also set this in the
# Settings page instead, which stores it in the database — this env var
# wins if both are set.
# OBSIDIAN_VAULT=/Users/you/Documents/MyVault

# Port for the production server (scripts/serve.sh). Default 3000.
# PORT=3000

# NTU COOL sync (課程頁的「同步 NTU COOL」). Log in to cool.ntu.edu.tw in your
# browser, open DevTools → Network, click any request to cool.ntu.edu.tw and
# copy the whole `Cookie` request header value. When the session expires the
# sync says so; copy a fresh one here and restart the server.
# COOL_COOKIE=_legacy_normandy_session=...; _normandy_session=...;log_session_id=...

# With COOL_COOKIE set, the server also syncs COOL on its own: between 08:00 and
# 18:00, whenever the last sync is over an hour old, with a macOS notification
# for new assignments and announcements. Set to 0 to turn that off.
# COOL_AUTO_SYNC=0
